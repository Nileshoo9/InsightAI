generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  files     File[]
  insights  Insight[]

  @@index([createdAt])
}

model File {
  id         String      @id @default(cuid())
  userId     String
  fileName   String
  uploadedAt DateTime    @default(now())
  rawPreview Json?
  /// Complete normalized source rows. rawPreview is strictly a UI preview.
  rawData     Json?
  rawRowCount Int        @default(0)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  records    DataRecord[]
  insights   Insight[]

  @@index([userId, uploadedAt])
}

model DataRecord {
  id        String   @id @default(cuid())
  fileId    String
  date      DateTime
  revenue   Float
  product   String
  quantity  Int
  category  String?
  customer  String?
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId])
}

model Insight {
  id           String   @id @default(cuid())
  userId       String
  fileId       String
  insightsText String
  description  String
  insightsJson String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  file         File     @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([fileId, createdAt])
}
